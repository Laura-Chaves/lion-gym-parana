<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lion Gym Paraná — Plantillas</title>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Segoe UI', sans-serif;
      background: #0f0f0f;
      color: white;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 2.5rem 1rem 4rem;
    }

    .logo-area {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin-bottom: 2rem;
    }

    .logo-area img {
      width: 90px;
      height: 90px;
      object-fit: contain;
      margin-bottom: 0.6rem;
      filter: drop-shadow(0 0 18px #cc0000aa);
    }

    .logo-texto {
      font-size: 1.8rem;
      font-weight: 900;
      color: #cc0000;
      letter-spacing: 3px;
    }

    .subtitulo {
      color: #666;
      font-size: 0.85rem;
      margin-top: 0.2rem;
      letter-spacing: 1px;
    }

    .nav-links {
      margin-top: 1rem;
      display: flex;
      gap: 1.5rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    .nav-links a {
      color: #888;
      text-decoration: none;
      font-size: 0.9rem;
      border-bottom: 1px solid transparent;
      transition: color 0.2s, border-color 0.2s;
    }

    .nav-links a:hover {
      color: #cc0000;
      border-color: #cc0000;
    }

    .contenedor {
      width: 100%;
      max-width: 640px;
    }

    .tarjeta {
      background: #1a1a1a;
      border: 2px solid #2a2a2a;
      border-radius: 16px;
      padding: 2rem;
      margin-bottom: 2rem;
    }

    .tarjeta h2 {
      font-size: 1.1rem;
      color: #cc0000;
      margin-bottom: 1.2rem;
      letter-spacing: 0.5px;
    }

    .campo {
      margin-bottom: 1.1rem;
    }

    .campo label {
      display: block;
      font-size: 0.85rem;
      color: #aaa;
      margin-bottom: 0.4rem;
    }

    .campo .obligatorio { color: #cc0000; }

    .campo input,
    .campo select,
    .campo textarea {
      width: 100%;
      padding: 0.85rem;
      font-size: 1.05rem;
      border: 2px solid #333;
      border-radius: 8px;
      background: #111;
      color: white;
      outline: none;
      transition: border-color 0.2s;
      font-family: inherit;
    }

    .campo input:focus,
    .campo select:focus,
    .campo textarea:focus {
      border-color: #cc0000;
    }

    .fila-doble {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    .nivel-grid {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 0.6rem;
    }

    .nivel-opcion {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      background: #111;
      border: 2px solid #333;
      border-radius: 8px;
      padding: 0.7rem 0.5rem;
      cursor: pointer;
      font-size: 0.88rem;
      transition: border-color 0.2s, background 0.2s;
    }

    .nivel-opcion:has(input:checked) {
      border-color: #cc0000;
      background: rgba(204,0,0,0.08);
    }

    .nivel-opcion input { width: auto; margin: 0; }

    .tipo-plan-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.6rem;
    }

    .tipo-plan-opcion {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      background: #111;
      border: 2px solid #333;
      border-radius: 8px;
      padding: 0.7rem 0.9rem;
      cursor: pointer;
      font-size: 0.9rem;
      transition: border-color 0.2s, background 0.2s;
    }

    .tipo-plan-opcion:has(input:checked) {
      border-color: #cc0000;
      background: rgba(204,0,0,0.08);
    }

    .tipo-plan-opcion input { width: auto; margin: 0; }

    .btn-guardar, .btn-secundario {
      width: 100%;
      padding: 1rem;
      font-size: 1.05rem;
      font-weight: 700;
      background: #cc0000;
      color: #fff;
      border: none;
      border-radius: 10px;
      cursor: pointer;
      transition: background 0.2s;
    }

    .btn-guardar:hover { background: #aa0000; }
    .btn-guardar:disabled {
      background: #555;
      cursor: not-allowed;
    }

    .btn-secundario {
      background: transparent;
      border: 2px solid #333;
      color: #ccc;
    }
    .btn-secundario:hover { border-color: #cc0000; color: #cc0000; }

    .mensaje {
      margin-top: 1rem;
      padding: 0.9rem 1rem;
      border-radius: 8px;
      font-size: 0.9rem;
      display: none;
      line-height: 1.5;
    }

    .mensaje.exito {
      background: #0d2e1a;
      border: 1px solid #1a7a3a;
      color: #4cdf7a;
    }

    .mensaje.error {
      background: #2e0d0d;
      border: 1px solid #7a1a1a;
      color: #df4c4c;
    }

    .nivel-seccion { margin-bottom: 1.5rem; }
    .nivel-seccion:last-child { margin-bottom: 0; }

    .nivel-titulo {
      font-size: 0.85rem;
      color: #888;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      margin-bottom: 0.6rem;
      padding-bottom: 0.4rem;
      border-bottom: 1px solid #2a2a2a;
    }

    .plantilla-item {
      background: rgba(255,255,255,0.04);
      border: 1px solid #2a2a2a;
      border-radius: 8px;
      padding: 0.8rem 1rem;
      margin-bottom: 0.6rem;
      font-size: 0.9rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.6rem;
    }

    .plantilla-item .acciones {
      display: flex;
      gap: 0.5rem;
      flex-shrink: 0;
    }

    .plantilla-item .acciones button {
      width: auto;
      padding: 0.4rem 0.8rem;
      font-size: 0.75rem;
    }

    .btn-eliminar {
      background: transparent;
      border: 1px solid #7a1a1a;
      color: #df4c4c;
      border-radius: 8px;
      cursor: pointer;
    }
    .btn-eliminar:hover { background: rgba(204,0,0,0.1); }

    .vacio {
      color: #666;
      font-size: 0.88rem;
      text-align: center;
      padding: 1rem 0;
    }

    .dia-bloque {
      border: 2px solid #2a2a2a;
      border-radius: 12px;
      padding: 1.2rem;
      margin-bottom: 1.2rem;
      background: rgba(255,255,255,0.02);
    }

    .dia-encabezado {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
      gap: 0.7rem;
    }

    .dia-encabezado .campo { flex: 1; margin-bottom: 0; }

    .btn-quitar-dia {
      background: transparent;
      border: 1px solid #7a1a1a;
      color: #df4c4c;
      border-radius: 8px;
      padding: 0.6rem 0.8rem;
      font-size: 0.8rem;
      cursor: pointer;
      white-space: nowrap;
    }
    .btn-quitar-dia:hover { background: rgba(204,0,0,0.1); }

    .ejercicio-fila {
      display: grid;
      grid-template-columns: 2fr 0.8fr 1fr 0.8fr 3.6rem 2.2rem;
      gap: 0.5rem;
      margin-bottom: 0.5rem;
      align-items: center;
    }

    .ejercicio-fila .combo-check {
      display: flex;
      align-items: center;
      justify-content: center;
      width: auto;
    }

    .ejercicio-fila .combo-check input { width: auto; }

    .ejercicio-fila input {
      padding: 0.6rem;
      font-size: 0.9rem;
      border: 2px solid #333;
      border-radius: 6px;
      background: #111;
      color: white;
    }

    .ejercicio-fila input:focus {
      outline: none;
      border-color: #cc0000;
    }

    .btn-quitar-ejercicio {
      background: transparent;
      border: none;
      color: #666;
      font-size: 1.3rem;
      cursor: pointer;
      line-height: 1;
      padding: 0.3rem;
    }
    .btn-quitar-ejercicio:hover { color: #df4c4c; }

    .btn-agregar-ejercicio {
      background: transparent;
      border: 1px dashed #444;
      color: #999;
      border-radius: 8px;
      padding: 0.55rem;
      width: 100%;
      cursor: pointer;
      font-size: 0.85rem;
      margin-top: 0.3rem;
    }
    .btn-agregar-ejercicio:hover { border-color: #cc0000; color: #cc0000; }

    .encabezados-ejercicio {
      display: grid;
      grid-template-columns: 2fr 0.8fr 1fr 0.8fr 3.6rem 2.2rem;
      gap: 0.5rem;
      font-size: 0.7rem;
      color: #777;
      margin-bottom: 0.4rem;
      padding: 0;
      text-transform: uppercase;
      letter-spacing: 0.3px;
      text-align: center;
    }

    .btn-agregar-dia {
      background: transparent;
      border: 2px dashed #333;
      color: #999;
      border-radius: 10px;
      padding: 0.9rem;
      width: 100%;
      cursor: pointer;
      font-size: 0.95rem;
      margin-bottom: 1.5rem;
    }
    .btn-agregar-dia:hover { border-color: #cc0000; color: #cc0000; }

    @media (max-width: 560px) {
      .ejercicio-fila { grid-template-columns: 1fr 1fr; }
      .encabezados-ejercicio { display: none; }
    }
  </style>
</head>
<body>

  <div class="logo-area">
    <img src="leon.webp" alt="Lion Gym">
    <div class="logo-texto">LION GYM</div>
    <div class="subtitulo">PARANÁ — PLANTILLAS DE RUTINA</div>
    <div class="nav-links">
      <a href="rutinas.html">Rutinas</a>
      <a href="panel-general.html">Panel general</a>
      <a href="#" onclick="cerrarSesion(); return false;">Cerrar sesión</a>
    </div>
  </div>

  <div class="contenedor">

    <div class="tarjeta">
      <h2>PLANTILLAS GUARDADAS</h2>
      <div id="listaPlantillas"><div class="vacio">Cargando...</div></div>
    </div>

    <div class="tarjeta">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.2rem;">
        <h2 id="tituloFormPlantilla" style="margin-bottom:0;">NUEVA PLANTILLA</h2>
        <button type="button" class="btn-secundario" id="btnCancelarEdicion" style="display:none; width:auto; padding:0.5rem 1rem; font-size:0.8rem;" onclick="prepararFormularioNuevo()">CANCELAR EDICIÓN</button>
      </div>

      <form id="formPlantilla">
        <div class="campo">
          <label>Nombre de la plantilla <span class="obligatorio">*</span></label>
          <input type="text" id="nombrePlantilla" placeholder="Ej: Full body 3 días — Principiante" required>
        </div>

        <div class="campo">
          <label>Nivel <span class="obligatorio">*</span></label>
          <div class="nivel-grid">
            <label class="nivel-opcion"><input type="radio" name="nivel" value="Principiante" checked> Principiante</label>
            <label class="nivel-opcion"><input type="radio" name="nivel" value="Intermedio"> Intermedio</label>
            <label class="nivel-opcion"><input type="radio" name="nivel" value="Avanzado"> Avanzado</label>
          </div>
        </div>

        <div class="campo">
          <label>Tipo de plan <span class="obligatorio">*</span></label>
          <div class="tipo-plan-grid">
            <label class="tipo-plan-opcion"><input type="radio" name="tipoPlan" value="Fuerza" checked> Fuerza</label>
            <label class="tipo-plan-opcion"><input type="radio" name="tipoPlan" value="Hipertrofia"> Hipertrofia</label>
            <label class="tipo-plan-opcion"><input type="radio" name="tipoPlan" value="Potencia"> Potencia</label>
            <label class="tipo-plan-opcion"><input type="radio" name="tipoPlan" value="Resistencia"> Resistencia</label>
            <label class="tipo-plan-opcion"><input type="radio" name="tipoPlan" value="Recomposición"> Recomposición</label>
            <label class="tipo-plan-opcion"><input type="radio" name="tipoPlan" value="Otro"> Otro</label>
          </div>
        </div>

        <div class="campo">
          <label>Objetivo</label>
          <textarea id="objetivoPlantilla" rows="2" placeholder="Ej: Adaptación general y técnica de base"></textarea>
        </div>

        <h2 style="margin-top:1.8rem;">DÍAS Y EJERCICIOS</h2>
        <div style="color:#888; font-size:0.82rem; margin-bottom:1rem; line-height:1.5;">
          En "Reps" podés escribir una repetición fija (ej: 10) o distinta por serie separada por guiones (ej: 12-10-10-8). Marcá el tilde de "Combinado" en un ejercicio para agruparlo con el que sigue en la lista (superset/biserie).
        </div>
        <div id="contenedorDias"></div>
        <button type="button" class="btn-agregar-dia" onclick="agregarDiaManual()">+ AGREGAR DÍA</button>

        <button type="submit" class="btn-guardar" id="btnGuardarPlantilla">GUARDAR PLANTILLA</button>
        <div class="mensaje" id="mensajePlantilla"></div>
      </form>
    </div>

  </div>

  <script>
    const SUPABASE_URL = 'https://hlhsrbstxxdanyckujem.supabase.co'
    const SUPABASE_KEY = 'sb_publishable_NOA6FfVrGTtkX0eu_rvyZA_Uyye2XRl'
    const { createClient } = supabase
    const db = createClient(SUPABASE_URL, SUPABASE_KEY)

    async function verificarAcceso() {
      const { data } = await db.auth.getSession()
      if (!data.session) {
        window.location.href = 'login.html'
        return
      }
      const { data: admin } = await db
        .from('administradores')
        .select('nombre')
        .eq('id', data.session.user.id)
        .eq('activo', true)
        .limit(1)

      if (!admin || admin.length === 0) {
        await db.auth.signOut()
        window.location.href = 'login.html'
      }
    }
    verificarAcceso()

    async function cerrarSesion() {
      await db.auth.signOut()
      window.location.href = 'login.html'
    }

    let contadorDias = 0
    let plantillaEditandoId = null

    function mostrarMensaje(elementoId, texto, tipo) {
      const el = document.getElementById(elementoId)
      el.className = `mensaje ${tipo}`
      el.textContent = texto
      el.style.display = 'block'
    }

    function agregarDia(nombreDia) {
      contadorDias++
      const idDia = contadorDias
      const contenedor = document.getElementById('contenedorDias')
      const numeroVisible = contenedor.children.length + 1

      const bloque = document.createElement('div')
      bloque.className = 'dia-bloque'
      bloque.id = `dia-${idDia}`
      bloque.innerHTML = `
        <div class="dia-encabezado">
          <div class="campo">
            <label>Nombre del día</label>
            <input type="text" class="nombre-dia" value="${nombreDia ? nombreDia.replace(/"/g, '&quot;') : `Día ${numeroVisible}`}" placeholder="Ej: Día 1 — Pecho y tríceps">
          </div>
          <button type="button" class="btn-quitar-dia" onclick="quitarDia(${idDia})">QUITAR DÍA</button>
        </div>
        <div class="encabezados-ejercicio">
          <span>Ejercicio</span><span>Series</span><span>Reps</span><span>Peso (kg)</span><span>Combinado</span><span></span>
        </div>
        <div class="lista-ejercicios" id="ejercicios-${idDia}"></div>
        <button type="button" class="btn-agregar-ejercicio" onclick="agregarEjercicio(${idDia})">+ Agregar ejercicio</button>
      `
      contenedor.appendChild(bloque)
      return idDia
    }

    function agregarDiaManual() {
      const idDia = agregarDia()
      agregarEjercicio(idDia)
      agregarEjercicio(idDia)
      agregarEjercicio(idDia)
    }

    function quitarDia(idDia) {
      const bloque = document.getElementById(`dia-${idDia}`)
      if (bloque) bloque.remove()
    }

    function agregarEjercicio(idDia, valores) {
      const v = valores || {}
      const lista = document.getElementById(`ejercicios-${idDia}`)
      const fila = document.createElement('div')
      fila.className = 'ejercicio-fila'
      fila.innerHTML = `
        <input type="text" class="ej-nombre" placeholder="Ejercicio" value="${v.ejercicio ? String(v.ejercicio).replace(/"/g, '&quot;') : ''}">
        <input type="text" class="ej-series" placeholder="Series" value="${v.series ? String(v.series).replace(/"/g, '&quot;') : ''}">
        <input type="text" class="ej-reps" placeholder="Ej: 12-10-10-8" value="${v.repeticiones ? String(v.repeticiones).replace(/"/g, '&quot;') : ''}">
        <input type="text" class="ej-peso" placeholder="Kg" value="${v.peso_kg ? String(v.peso_kg).replace(/"/g, '&quot;') : ''}">
        <label class="combo-check" title="Combinar con el ejercicio siguiente">
          <input type="checkbox" class="ej-combo" ${v.combinado_siguiente ? 'checked' : ''}>
        </label>
        <button type="button" class="btn-quitar-ejercicio" onclick="this.parentElement.remove()">&times;</button>
      `
      lista.appendChild(fila)
    }

    function cargarDiasEnFormulario(dias) {
      document.getElementById('contenedorDias').innerHTML = ''
      contadorDias = 0

      if (!dias || dias.length === 0) {
        agregarDiaManual()
        return
      }

      dias.forEach(dia => {
        const idDia = agregarDia(dia.nombre_dia)
        const ejercicios = dia.ejercicios || []
        if (ejercicios.length === 0) {
          agregarEjercicio(idDia)
        } else {
          ejercicios.forEach(ej => agregarEjercicio(idDia, ej))
        }
      })
    }

    async function obtenerDiasDeRutina(rutinaId) {
      const { data: dias } = await db
        .from('rutina_dias')
        .select('*')
        .eq('rutina_id', rutinaId)
        .order('numero_dia', { ascending: true })

      const diasConEjercicios = []
      for (const dia of dias || []) {
        const { data: ejercicios } = await db
          .from('rutina_ejercicios')
          .select('*')
          .eq('dia_id', dia.id)
          .order('orden', { ascending: true })

        diasConEjercicios.push({ nombre_dia: dia.nombre_dia, ejercicios: ejercicios || [] })
      }
      return diasConEjercicios
    }

    function prepararFormularioNuevo() {
      plantillaEditandoId = null
      document.getElementById('formPlantilla').reset()
      document.getElementById('mensajePlantilla').style.display = 'none'
      document.getElementById('contenedorDias').innerHTML = ''
      contadorDias = 0
      agregarDiaManual()

      document.getElementById('tituloFormPlantilla').textContent = 'NUEVA PLANTILLA'
      document.getElementById('btnGuardarPlantilla').textContent = 'GUARDAR PLANTILLA'
      document.getElementById('btnCancelarEdicion').style.display = 'none'
    }

    async function cargarPlantillas() {
      const { data: plantillas, error } = await db
        .from('rutinas')
        .select('*')
        .eq('es_plantilla', true)
        .order('nivel', { ascending: true })
        .order('nombre', { ascending: true })

      const lista = document.getElementById('listaPlantillas')

      if (error) {
        lista.innerHTML = '<div class="vacio">Error al cargar las plantillas.</div>'
        return
      }

      if (!plantillas || plantillas.length === 0) {
        lista.innerHTML = '<div class="vacio">Todavía no hay plantillas cargadas. Armá la primera abajo.</div>'
        return
      }

      const niveles = ['Principiante', 'Intermedio', 'Avanzado']
      let html = ''

      niveles.forEach(nivel => {
        const deEsteNivel = plantillas.filter(p => p.nivel === nivel)
        if (deEsteNivel.length === 0) return

        html += `<div class="nivel-seccion"><div class="nivel-titulo">${nivel}</div>`
        html += deEsteNivel.map(p => `
          <div class="plantilla-item">
            <span>${p.nombre} — ${p.tipo_plan}</span>
            <div class="acciones">
              <button type="button" class="btn-secundario" onclick="editarPlantilla('${p.id}')">EDITAR</button>
              <button type="button" class="btn-eliminar" onclick="eliminarPlantilla('${p.id}')">ELIMINAR</button>
            </div>
          </div>
        `).join('')
        html += `</div>`
      })

      lista.innerHTML = html || '<div class="vacio">Todavía no hay plantillas cargadas.</div>'
    }

    async function editarPlantilla(id) {
      const { data: plantilla, error } = await db
        .from('rutinas')
        .select('*')
        .eq('id', id)
        .single()

      if (error || !plantilla) {
        mostrarMensaje('mensajePlantilla', 'No se pudo cargar la plantilla.', 'error')
        return
      }

      plantillaEditandoId = plantilla.id

      document.getElementById('mensajePlantilla').style.display = 'none'
      document.getElementById('nombrePlantilla').value = plantilla.nombre || ''
      document.getElementById('objetivoPlantilla').value = plantilla.objetivo || ''

      const radioNivel = document.querySelector(`input[name="nivel"][value="${plantilla.nivel}"]`)
      if (radioNivel) radioNivel.checked = true

      const radioTipo = document.querySelector(`input[name="tipoPlan"][value="${plantilla.tipo_plan}"]`)
      if (radioTipo) radioTipo.checked = true

      const dias = await obtenerDiasDeRutina(plantilla.id)
      cargarDiasEnFormulario(dias)

      document.getElementById('tituloFormPlantilla').textContent = `EDITANDO: ${plantilla.nombre}`
      document.getElementById('btnGuardarPlantilla').textContent = 'GUARDAR CAMBIOS'
      document.getElementById('btnCancelarEdicion').style.display = 'block'

      document.getElementById('formPlantilla').scrollIntoView({ behavior: 'smooth' })
    }

    async function eliminarPlantilla(id) {
      if (!confirm('¿Eliminar esta plantilla? Esto no afecta las rutinas ya asignadas a socios que se hayan armado a partir de ella.')) return

      const { data: dias } = await db.from('rutina_dias').select('id').eq('rutina_id', id)
      const idsDias = (dias || []).map(d => d.id)

      if (idsDias.length > 0) {
        await db.from('rutina_ejercicios').delete().in('dia_id', idsDias)
        await db.from('rutina_dias').delete().eq('rutina_id', id)
      }

      const { error } = await db.from('rutinas').delete().eq('id', id)

      if (error) {
        alert('Error al eliminar: ' + error.message)
        return
      }

      if (plantillaEditandoId === id) prepararFormularioNuevo()
      await cargarPlantillas()
    }

    document.getElementById('formPlantilla').addEventListener('submit', async (e) => {
      e.preventDefault()
      document.getElementById('mensajePlantilla').style.display = 'none'

      const nombre = document.getElementById('nombrePlantilla').value.trim()
      const nivel = document.querySelector('input[name="nivel"]:checked')?.value
      const tipoPlan = document.querySelector('input[name="tipoPlan"]:checked')?.value
      const objetivo = document.getElementById('objetivoPlantilla').value.trim()

      if (!nombre || !nivel || !tipoPlan) {
        mostrarMensaje('mensajePlantilla', 'Completá nombre, nivel y tipo de plan.', 'error')
        return
      }

      const bloquesDias = document.querySelectorAll('.dia-bloque')
      if (bloquesDias.length === 0) {
        mostrarMensaje('mensajePlantilla', 'Agregá al menos un día.', 'error')
        return
      }

      const dias = []
      for (const bloque of bloquesDias) {
        const nombreDia = bloque.querySelector('.nombre-dia').value.trim() || 'Día'
        const ejercicios = []
        bloque.querySelectorAll('.ejercicio-fila').forEach(fila => {
          const nombreEj = fila.querySelector('.ej-nombre').value.trim()
          if (!nombreEj) return
          ejercicios.push({
            ejercicio: nombreEj,
            series: fila.querySelector('.ej-series').value.trim() || null,
            repeticiones: fila.querySelector('.ej-reps').value.trim() || null,
            peso_kg: fila.querySelector('.ej-peso').value.trim() || null,
            combinado_siguiente: fila.querySelector('.ej-combo').checked
          })
        })
        dias.push({ nombreDia, ejercicios })
      }

      if (dias.every(d => d.ejercicios.length === 0)) {
        mostrarMensaje('mensajePlantilla', 'Cargá al menos un ejercicio en algún día.', 'error')
        return
      }

      const btn = document.getElementById('btnGuardarPlantilla')
      btn.disabled = true
      btn.textContent = 'GUARDANDO...'

      try {
        let plantillaId = plantillaEditandoId

        if (plantillaEditandoId) {
          const { error: errorUpdate } = await db
            .from('rutinas')
            .update({ nombre, nivel, tipo_plan: tipoPlan, objetivo: objetivo || null })
            .eq('id', plantillaEditandoId)

          if (errorUpdate) throw errorUpdate

          const { data: diasViejos } = await db
            .from('rutina_dias')
            .select('id')
            .eq('rutina_id', plantillaEditandoId)

          const idsDiasViejos = (diasViejos || []).map(d => d.id)
          if (idsDiasViejos.length > 0) {
            await db.from('rutina_ejercicios').delete().in('dia_id', idsDiasViejos)
            await db.from('rutina_dias').delete().eq('rutina_id', plantillaEditandoId)
          }
        } else {
          const { data: plantillaCreada, error: errorPlantilla } = await db
            .from('rutinas')
            .insert({
              socio_id: null,
              es_plantilla: true,
              nivel,
              nombre,
              tipo_plan: tipoPlan,
              objetivo: objetivo || null,
              activa: false
            })
            .select()
            .single()

          if (errorPlantilla) throw errorPlantilla
          plantillaId = plantillaCreada.id
        }

        for (let i = 0; i < dias.length; i++) {
          const { data: diaCreado, error: errorDia } = await db
            .from('rutina_dias')
            .insert({
              rutina_id: plantillaId,
              numero_dia: i + 1,
              nombre_dia: dias[i].nombreDia
            })
            .select()
            .single()

          if (errorDia) throw errorDia

          if (dias[i].ejercicios.length > 0) {
            const filasEjercicios = dias[i].ejercicios.map((ej, index) => ({
              dia_id: diaCreado.id,
              orden: index + 1,
              ejercicio: ej.ejercicio,
              series: ej.series,
              repeticiones: ej.repeticiones,
              peso_kg: ej.peso_kg,
              combinado_siguiente: ej.combinado_siguiente
            }))

            const { error: errorEjercicios } = await db
              .from('rutina_ejercicios')
              .insert(filasEjercicios)

            if (errorEjercicios) throw errorEjercicios
          }
        }

        mostrarMensaje('mensajePlantilla', plantillaEditandoId
          ? 'Cambios guardados correctamente.'
          : 'Plantilla guardada correctamente. Ya está disponible al armar rutinas.', 'exito')

        await cargarPlantillas()
        if (plantillaEditandoId) prepararFormularioNuevo()

      } catch (err) {
        mostrarMensaje('mensajePlantilla', 'Error al guardar la plantilla: ' + err.message, 'error')
      }

      btn.disabled = false
      btn.textContent = plantillaEditandoId ? 'GUARDAR CAMBIOS' : 'GUARDAR PLANTILLA'
    })

    prepararFormularioNuevo()
    cargarPlantillas()
  </script>
</body>
</html>
